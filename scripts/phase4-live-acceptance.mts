/** Real HTTP, isolated synthetic projects. Provider availability is reported honestly. */
import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';
const base=process.argv[2]??'http://localhost:8789',out=path.resolve('output/phase4-live-qa-2026-10-23');fs.mkdirSync(out,{recursive:true});
const token=(await(await fetch(base+'/api/auth/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({user:'taha'})})).json() as any).token;
const headers={authorization:'Bearer '+token,'content-type':'application/json'},prefix='p4-'+Date.now().toString(36),calls:any[]=[],checks:any[]=[];let request=0;
async function http(url:string,body?:unknown){const response=await fetch(base+url,{method:body===undefined?'GET':'POST',headers,body:body===undefined?undefined:JSON.stringify(body)}),value=await response.json();assert.ok(response.ok,`${response.status}: ${JSON.stringify(value)}`);return value as any;}
async function tool(project:string,name:string,input:unknown){const value=await http(`/api/projects/${project}/tools/${name}`,{input});calls.push({project,name,input,response:value});return value;}
async function project(label:string){const id=prefix+'-'+label;await http('/api/projects',{id,name:'Phase 4 '+label,projectType:'superstructure'});return id;}
async function generate(p:string,requirements:unknown,intent='Explicit Phase 4 geometry'){const input={intent,requestId:'live-'+(++request),requirements},plan=(await tool(p,'model_plan',input)).result;assert.equal(plan.summary.status,'READY');return tool(p,'model_generate',{...input,planId:plan.summary.planId});}
const query=async(p:string,name:string,input={})=>(await tool(p,'project_query',{tool:name,input})).result;
const family=(name:string,category:string)=>({name,category,parameters:['width','depth','height'].map(key=>({key,name:key,scope:'type',dataType:'length',required:true})),representation:{kind:'box',width:'width',depth:'depth',height:'height'}});
const component=(name:string,family:string,size:number[])=>({kind:'component',name,family,parameters:Object.fromEntries(['width','depth','height'].map((k,i)=>[k,size[i]]))});
const reuse=await project('reuse');await tool(reuse,'bim_create_storeys',{storeys:[{name:'L0',elevation:0}]});
await generate(reuse,{kind:'definitions',families:[family('Valve','plumbing.valve'),family('Panel','electrical.solar_device')],types:[component('V50','Valve',[.2,.2,.2]),component('PV','Panel',[2,1,.04])]});
for(const [name,count,y]of [['column',20,0],['V50',50,10],['PV',100,20]] as const)await generate(reuse,{kind:'instances',storey:'L0',...(name==='column'?{definition:{kind:'column',name:'C1',units:'mm',profile:{shape:'rect',b:400,h:600}}}:{type:name}),placements:Array.from({length:count},(_,i)=>({at:[i*3,y],...(name==='column'?{height:3}:{})}))});
let library=await query(reuse,'semantic.library');assert.equal(library.types.length,3);assert.deepEqual(library.types.map((t:any)=>t.instances.length).sort((a:number,b:number)=>a-b),[20,50,100]);checks.push({test:'A',counts:[20,50,100],types:3});
const rc=await project('assembly');await tool(rc,'bim_create_storeys',{storeys:[{name:'L0',elevation:0}]});await generate(rc,{kind:'definitions',types:[{kind:'column',name:'C1',profile:{shape:'rect',b:.4,h:.6}}]});
const definition={name:'Persistent RC',parameters:{height:3,spacing:.15},parts:[{role:'column',type:'C1',height:{parameter:'height'}}],reinforcement:{hostRole:'column',cover:.03,diameter:.016,stirrupDiameter:.008,spacing:{parameter:'spacing'},steelGrade:'B500B'},constraints:[{parameter:'spacing',min:.08,max:.3}]};
await generate(rc,{kind:'assembly-type',definition,storey:'L0',placements:[{at:[0,0]},{at:[4,0],overrides:{spacing:.2}}]});
library=await query(rc,'semantic.library');const type=library.assemblies[0],originalTree=await http(`/api/projects/${rc}/tree`),revisionDef={...type,parameters:{height:4,spacing:.1}};for(const key of ['id','revision','instances'])delete revisionDef[key];
const revised=await tool(rc,'model_revise',{changes:[{tool:'bim_update_assembly_type',input:{type:type.id,expectedRevision:type.revision,definition:revisionDef}}]});assert.equal(revised.summary.regenerated.length,4);assert.equal((await tool(rc,'model_validate',{})).result.issues.length,0);await http(`/api/projects/${rc}/undo`,{});assert.deepEqual(await http(`/api/projects/${rc}/tree`),originalTree);checks.push({test:'B/C/D',assemblyTypes:1,occurrences:2,regenerated:4,undo:true});
const csv='Type,Width,Depth,Height,X,Y\n'+Array.from({length:40},(_,i)=>`C-doc,400,600,3,${i*2},100`).join('\n'),upload=(await tool(reuse,'files_upload',{filename:'columns.csv',base64:Buffer.from(csv).toString('base64')})).result;await tool(reuse,'files_register',{filename:'columns.csv',asset:upload.asset});
await generate(reuse,{kind:'document-model',source:{file:'F-0001',version:1},mapping:{type:'Type',width:'Width',depth:'Depth',height:'Height',x:'X',y:'Y'},units:'mm',placementUnits:'m',storey:'L0',category:'structure.column',reviewedMapping:true,role:'geometry'});
library=await query(reuse,'semantic.library');assert.equal(library.types.length,3);assert.equal(library.types.find((t:any)=>t.kind==='column').instances.length,60);checks.push({test:'E',documentRows:40,existingColumnTypeReused:true});
const building=await project('building'),natural={intent:'Toplam brüt alanı 600 m2 olan 3 katlı bina oluştur',requestId:'natural-building'},plan=(await tool(building,'model_plan',natural)).result;assert.equal(plan.summary.status,'READY');await tool(building,'model_generate',{...natural,planId:plan.summary.planId});
for(const [name,domain,classification,diameter,offset]of [['CW','piping','domestic_cold_water',.025,2.5],['EL','electrical','power',.02,2.2]] as const)await generate(building,{kind:'network',name,domain,classification,diameter,shaft:[Math.sqrt(200)/4+(domain==='electrical'?.15:0),Math.sqrt(200)/4],terminals:[0,1,2].map(i=>({storey:`UMB-L${i}`,at:[Math.sqrt(200)/2,Math.sqrt(200)/4+(domain==='electrical'?.3:0)],offset})),routingSpaceApproved:true});
const validation=(await tool(building,'model_validate',{})).result;assert.equal(validation.issues.length,0);checks.push({test:'F/G',naturalLanguage:'bounded deterministic intent parser; real LLM not claimed',systems:['CW','EL'],issues:0});
for(const p of [rc,reuse,building])for(const ext of ['ifc','frag']){const response=await fetch(`${base}/api/projects/${p}/model.${ext}`,{headers});assert.equal(response.status,200);const bytes=Buffer.from(await response.arrayBuffer());assert.ok(bytes.length>1000);fs.writeFileSync(path.join(out,p+'.'+ext),bytes);}
const energy=await project('energy');await tool(energy,'bim_create_storeys',{storeys:[{name:'L0',elevation:0}]});
await generate(energy,{kind:'definitions',families:[family('Panel','electrical.solar_device'),family('Mount','architecture.generic_model')],types:[component('PV','Panel',[2,1,.04]),component('Mount','Mount',[1.5,.5,1.5])]});
await generate(energy,{kind:'assembly-type',definition:{name:'PV table',parameters:{panelOffset:1.5},parts:[{role:'panel',type:'PV',offset:{parameter:'panelOffset'}},{role:'mount',type:'Mount'}]},storey:'L0',placements:Array.from({length:100},(_,i)=>({at:[(i%20)*3,Math.floor(i/20)*3]}))});
const energyLibrary=await query(energy,'semantic.library');assert.equal(energyLibrary.assemblies.length,1);assert.equal(energyLibrary.assemblies[0].instances.length,100);assert.equal(energyLibrary.types.find((t:any)=>t.name==='PV').instances.length,100);checks.push({test:'I',assemblyTypes:1,assemblies:100,panels:100,mounts:100});
const dense=await project('density');await tool(dense,'bim_create_storeys',{storeys:[{name:'L0',elevation:0}]});await generate(dense,{kind:'definitions',families:[family('Panel','electrical.solar_device'),family('Valve','plumbing.valve')],types:[component('PV','Panel',[2,1,.04]),component('V','Valve',[.2,.2,.2])]});
let tick=performance.now();for(let k=0;k<2;k++)for(let offset=0;offset<2500;offset+=1000)await generate(dense,{kind:'instances',storey:'L0',type:k?'V':'PV',placements:Array.from({length:Math.min(1000,2500-offset)},(_,i)=>{const n=k*2500+offset+i;return {at:[(n%100)*3,Math.floor(n/100)*3]};})});const generationMs=performance.now()-tick;
const densityLibrary=await query(dense,'semantic.library');assert.equal(densityLibrary.types.length,2);assert.deepEqual(densityLibrary.types.map((t:any)=>t.instances.length),[2500,2500]);const exportMetrics:any={};
for(const ext of ['ifc','frag']){tick=performance.now();const response=await fetch(`${base}/api/projects/${dense}/model.${ext}`,{headers});assert.equal(response.status,200);const bytes=Buffer.from(await response.arrayBuffer());fs.writeFileSync(path.join(out,'density.'+ext),bytes);exportMetrics[ext]={ms:performance.now()-tick,bytes:bytes.length};}
checks.push({test:'performance',instances:5000,families:2,types:2,generationMs,exports:exportMetrics,scope:'Real HTTP and Fragments generation; browser load and DOM measurements recorded separately.'});
const assistant=await http('/api/assistant/status');checks.push({test:'J',status:assistant.enabled?'CONFIGURED; run provider acceptance separately':'NOT TESTED',reason:assistant.enabled?'Provider is available':'No provider configured; scripted clients are not real LLM evidence'});
fs.writeFileSync(path.join(out,'calls.json'),JSON.stringify(calls,null,2));const result={base,checks,projects:{reuse,assembly:rc,building,energy,density:dense},assistant};fs.writeFileSync(path.join(out,'acceptance.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
