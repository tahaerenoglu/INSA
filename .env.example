# PostgreSQL (shared by the web server and the MCP server). Leave empty to use JSON files in INSA_DATA.
INSA_PG_URL=postgres://insa:insa@localhost:5432/insa
INSA_DATA=./data
INSA_PROJECT=ornek-ofis
# auto | ai | all  (ai: Claude's writes wait for approval in the web UI)
INSA_APPROVAL=ai
PORT=8787
# In-app assistant (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=
INSA_AI_MODEL=claude-sonnet-5-5
# Google 3D map feature. For local use, put this in ignored .env.google.local.
# A browser Maps API key is sent only to signed-in readers after the access check.
GOOGLE_MAPS_API_KEY=
# Optional Cesium ion token with assets:read access to Google 3D Tiles asset 2275207.
CESIUM_ION_ACCESS_TOKEN=
